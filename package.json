{
  "name": "gp-programinha",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "agent:dev": "node backend/agent/server.mjs",
    "test:agent": "node --test backend/agent/server.test.mjs",
    "projects:dev": "node backend/projects/server.mjs",
    "test:projects": "node --test backend/projects/server.test.mjs",
    "test": "npm run test:agent && npm run test:projects"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.1"
  }
}
