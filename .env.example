# Local GP Bridge (browser client)
VITE_GP_BRIDGE_URL=http://127.0.0.1:8765

# GP Agent Planner — server only; never expose these VITE_ prefixed.
AGENT_HOST=127.0.0.1
AGENT_PORT=18787
AGENT_API_TOKEN=replace-with-a-long-random-secret
AGENT_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# GP Projects API — configure only in the server environment
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
PROJECTS_HOST=127.0.0.1
PROJECTS_PORT=18788
PROJECTS_DATA_DIR=/var/lib/gp-programinha/projects
PROJECTS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
